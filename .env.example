# Copiar a .env en la raiz y completar los valores locales.
# .env esta ignorado por Git. No reemplazar un .env existente sin conservarlo.

# PostgreSQL: Spring Boot y Docker usan el mismo usuario y contrasena.
DB_URL=jdbc:postgresql://localhost:5432/vocacional_db
DB_USERNAME=rumbo_app
DB_PASSWORD=

# Nombre de la base que crea Docker; debe coincidir con la base de DB_URL.
POSTGRES_DB=vocacional_db

# Opciones de desarrollo con PostgreSQL.
DB_DDL_AUTO=update
DB_SHOW_SQL=true
DB_SQL_INIT_MODE=always
PORT=8081

# Opcionales: fotos de perfil y adjuntos privados.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Solo para el primer arranque con el perfil railway (variables privadas en Railway).
# Conservar estos valores fuera del repositorio. Contrasena: 12+ caracteres, maximo 72 bytes UTF-8.
# Si ya existe un administrador activo, estas variables no modifican su cuenta.
# RUMBO_ADMIN_CORREO=
# RUMBO_ADMIN_CONTRASENIA=
# RUMBO_ADMIN_USUARIO=administrador
